{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "bun-types",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/link": [
        "./src/client/compat/next-link.tsx"
      ],
      "next/navigation": [
        "./src/client/compat/next-navigation.ts"
      ],
      "next-auth/react": [
        "./src/client/compat/next-auth-react.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "prisma"
  ]
}
