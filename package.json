{
  "name": "si-cehat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash ./setup.sh",
    "dev": "bunx vite",
    "dev:api": "bun --watch src/server/index.ts",
    "build": "bash ./build.sh",
    "build:client": "bunx vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "lint": "bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit push",
    "db:seed": "bun run src/server/db/seed.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "12.23.12",
    "hono": "^4.13.13",
    "motion": "12.23.12",
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.1.12",
    "wouter": "^3.13.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.4.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "framer-motion": "12.23.12",
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6"
  }
}
